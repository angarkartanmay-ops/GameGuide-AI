# ─── chat-proxy edge function ───────────────────────────────────────────────
# Copy to `supabase/functions/.env` (gitignored) for local serving:
#   supabase functions serve chat-proxy --env-file supabase/functions/.env
#
# For production these same values go in:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# NOTHING here requires a credit card. Every provider below has a genuinely
# free tier that is rate-limited rather than credit-metered, which is why the
# router spends them in cost order and stops at each one's daily cap.


# ═══ MINIMUM TO GET A REPLY ═════════════════════════════════════════════════
# You need AT LEAST ONE of the four provider keys. With none of them the mesh
# has nothing to call and every request ends in MESH_EXHAUSTED.

# Groq — the workhorse. Free tier is rate-limited (~30 req/min, ~1000/day per
# model), no card, nothing to run out of. Also serves groq/compound, the
# self-searching model used for "what's new" questions. Start here.
#   https://console.groq.com/keys
GROQ_API_KEY=

# Google — vision, OCR and image generation. Without this, screenshot analysis
# falls back to OpenRouter's free vision models, which are weaker on dense HUDs.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=


# ═══ STRONGLY RECOMMENDED (still free) ══════════════════════════════════════

# Cerebras — a second free pool with its own quota, so exhausting Groq does not
# take the whole mesh down.
#   https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter — free vision fallback plus the widest free model selection.
# NOTE: the model *catalog* is fetched without auth, so model discovery works
# even with this blank; the key is only needed to actually CALL the models.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ═══ PERSISTENCE (optional locally, required in production) ═════════════════
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically in
# production. Set them locally only if you want rate limiting and player memory
# to actually persist; without them the function degrades to an in-memory
# limiter and simply skips memory. It does not error.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Without it, every request pays a slower remote token
# check instead of verifying JWT signatures locally.
#   Dashboard → Project Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=

# Any random string. Salts the hash of anonymous IPs so raw IPs are never stored.
#   Generate: openssl rand -hex 32
# RATE_LIMIT_SALT=

# Shared secret proving requests come from your Discord bot, so the proxy rate
# limits per Discord user instead of lumping the whole bot into one IP bucket.
# Must match BOT_SERVICE_TOKEN in the bot's env.
# BOT_SERVICE_TOKEN=


# ═══ TUNING (all optional, sensible defaults) ═══════════════════════════════

# Daily request caps per provider. Raise these when you upgrade a plan.
# GROQ_DAILY_CAP=1000
# CEREBRAS_DAILY_CAP=800
# OPENROUTER_DAILY_CAP=50        # ~1000 once your OpenRouter account holds credit

# Set to 1 to let the router fall back to PAID models when the free tiers are
# exhausted, so answer quality degrades gracefully instead of failing. Only
# models at or under MAX_PAID_PROMPT_USD_PER_MTOK qualify — at a few users a
# day that is cents per month. Leave unset to stay strictly free.
# ENABLE_PAID_FALLBACK=1
# MAX_PAID_PROMPT_USD_PER_MTOK=0.10
# PAID_DAILY_CAP=2000

# Set to 1 to disable the self-searching (agentic) models. They add latency
# because tool calls run before the first token; turn this on if recency
# answers feel too slow.
# DISABLE_AGENTIC=1


# ═══ BETTER SEARCH RECALL (optional, free tiers exist) ══════════════════════
# Without any of these, search falls back to free unauthenticated backends
# (SearXNG, DuckDuckGo), which work but return fewer and noisier results.
# SERPER_API_KEY=          # 2500 free/month — best value of the three
# GOOGLE_CSE_ID=           # 100 free/day, pairs with GOOGLE_API_KEY
# BRAVE_SEARCH_API_KEY=

# ═══ GAME-SPECIFIC OFFICIAL APIs (optional) ════════════════════════════════
# Only affect these specific games; everything else is unaffected.
# CLASH_ROYALE_API_KEY=
# CLASH_OF_CLANS_API_KEY=
# BRAWL_STARS_API_KEY=
