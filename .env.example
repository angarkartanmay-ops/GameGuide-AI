# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Vite only exposes vars prefixed VITE_.
#
# These point the browser at whichever chat-proxy you want to talk to.

# ── Option A: test against a LOCALLY served edge function ──────────────────
#   supabase functions serve chat-proxy --env-file supabase/functions/.env
# The local functions runtime listens on 54321.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<your project's anon key>

# ── Option B: test against your DEPLOYED project ───────────────────────────
# VITE_SUPABASE_URL=https://vtvjbjmquxqlrwwrmzya.supabase.co
# VITE_SUPABASE_ANON_KEY=<your project's anon key>
#
# Note: Option B talks to whatever is currently deployed. Until you run
# `supabase functions deploy chat-proxy`, that is still the OLD backend.
