# ═══════════════════════════════════════════════════════════════════════════
#  GameGuide-AI Discord Bot — environment variables
#  ───────────────────────────────────────────────────────────────────────
#  Copy to .env and fill in the values:
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=                # Bot token → https://discord.com/developers/applications → Bot tab → Reset Token
DISCORD_CLIENT_ID=            # Application ID (same page, "General Information")
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=            # Supabase → Project Settings → API → "anon public"

# ─── STRONGLY RECOMMENDED ──────────────────────────────────────────────────
# Without this, chat history persistence is disabled (RLS blocks anon writes).
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API → "service_role" (KEEP SECRET)

# Optional dev shortcut for `npm run register:guild`
DISCORD_GUILD_ID=

# ─── 24/7 HEALTH + KEEP-ALIVE (set ONE of these per platform) ──────────────
# All free hosts: keep the bot's HTTP server bound to this port. Most hosts
# inject PORT automatically; this is the fallback.
PORT=3000

# Self-ping URL — required for hosts that sleep idle services
# (Render free, Replit, Cyclic). Set this to your bot's public URL
# WITHOUT trailing slash. The bot will GET <URL>/ping every 4 min.
#   Render:  https://gameguide-bot.onrender.com
#   Replit:  https://gameguide-bot.<user>.repl.co
#   Koyeb:   https://gameguide-bot-<user>.koyeb.app
# Leave blank if you're on Fly.io / Railway / a VPS (no idle-sleep).
KEEPALIVE_URL=

# Override default 4-minute ping interval (ms). Most free tiers sleep at 15 min idle.
KEEPALIVE_INTERVAL_MS=240000

# ─── PREMIUM / MONETIZATION (all optional) ─────────────────────────────────
# Manual premium overrides — comma-separated Discord IDs.
# Synced into discord_entitlements at boot, because tier is resolved in
# Postgres and the quota function cannot read env. Additive: an existing row
# always wins, so this never downgrades a paying customer. To revoke, delete
# the row rather than clearing the variable.
PREMIUM_USER_IDS=
PREMIUM_GUILD_IDS=

# ─── /upgrade → the website's plans page ───────────────────────────────────
# /upgrade (and the Upgrade buttons) send the user to <SITE_URL>/#upgrade with
# a signed, one-hour link that already knows their Discord account. The page
# calls this bot's /api/plans and /api/checkout, and the bot creates the
# checkout with whichever provider below is configured. Without this secret
# the bot falls back to the direct payment links further down.
UPGRADE_LINK_SECRET=             # long random string, e.g. `openssl rand -hex 32`
# SITE_URL=https://gameguide.online   # where the plans page lives (CORS + return links)
# BILLING_API_ORIGINS=http://localhost:5173         # extra origins allowed to call /api/* (local dev)
# The website needs this bot's public address in its own env:
#   Vercel → VITE_BILLING_API_URL=https://<your-bot-host>

# Test / review sign-in on the plans page, for payment-provider reviewers (and
# you) who have no Discord to run /upgrade from. Signs in as a fixed TEST
# identity, never a real user. Off unless both are set (password 12+ chars).
# REVIEW_LOGIN_EMAIL=gameguideai.support+razorpay@gmail.com
# REVIEW_LOGIN_PASSWORD=
# REVIEW_DISCORD_USER_ID=100000000000000001   # the test identity (default)
# REVIEW_DISCORD_GUILD_ID=100000000000000002  # its test server (default)

# ─── STRIPE (required for paid Pro to actually work) ───────────────────────
# Without the secret key + webhook secret the bot still runs, but /premium can
# only show links — nobody who pays will be granted anything.
STRIPE_SECRET_KEY=               # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... from the webhook endpoint you create

# Payment Links → https://dashboard.stripe.com/payment-links
# The bot appends ?client_reference_id=<discord id> to these, so a buyer is
# linked to their Discord account automatically and is never asked for their
# snowflake. Create them as RECURRING subscription prices.
# Prices are set in plans.js; create the Stripe prices to match.
STRIPE_PAYMENT_LINK=             # Pro, $4.99/mo (recurring)
STRIPE_SERVER_PAYMENT_LINK=      # Whole-server plan, $14.99/mo (recurring)
STRIPE_LIFETIME_PAYMENT_LINK=    # Pro Lifetime, $39.99 (one-time)

# The Stripe PRICE ids behind those links (price_...). Strongly recommended:
# the webhook grants the plan that matches the price actually paid. Without
# them it falls back to matching the amount charged, which cannot tell a
# 100%-off coupon from anything else (those purchases are refused).
# Comma-separate to accept several prices for a plan (e.g. monthly + yearly).
STRIPE_PRICE_PRO=
STRIPE_PRICE_SERVER=
STRIPE_PRICE_LIFETIME=
# Yearly prices (ten months for twelve — see plans.js). Optional: without them
# the plans page offers yearly only on the providers that have it.
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SERVER_YEARLY=

# Point your Stripe webhook endpoint at https://<your-bot-host>/stripe-webhook
# and subscribe to: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed, charge.refunded,
# charge.dispute.created

# ─── RAZORPAY (India: UPI, cards, netbanking) — optional, runs beside Stripe ──
# The bot creates each buyer's checkout through the Razorpay API when they
# press a rupee button on /premium, so the Discord id travels in server-written
# notes the buyer cannot edit. Rupee prices are in plans.js.
# Dashboard → Account & Settings → API Keys (use Test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add new webhook:
#   URL    https://<your-bot-host>/razorpay-webhook
#   Secret any long random string — put the same one here
#   Events subscription.activated, subscription.charged, subscription.pending,
#          subscription.halted, subscription.cancelled, subscription.completed,
#          subscription.paused, subscription.resumed, subscription.updated,
#          payment_link.paid, refund.processed, payment.dispute.created
RAZORPAY_WEBHOOK_SECRET=
# Dashboard → Subscriptions → Plans → Create Plan: monthly, INR, amounts below
# (they must match plans.js). Paste the plan ids (plan_...). Lifetime needs none.
RAZORPAY_PLAN_PRO=               # Pro, ₹399 every 1 month
RAZORPAY_PLAN_SERVER=            # Server, ₹1199 every 1 month
RAZORPAY_PLAN_PRO_YEARLY=        # optional: Pro, ₹3999 every 1 year
RAZORPAY_PLAN_SERVER_YEARLY=     # optional: Server, ₹11999 every 1 year

# ─── LEMON SQUEEZY (worldwide cards; merchant of record — it handles sales tax) ─
# Create three products (Pro and Server as monthly subscriptions, Lifetime as a
# single payment) at the prices in plans.js. For each: the buy link (Share →
# Checkout link) and the variant id (product → Variants).
LEMONSQUEEZY_WEBHOOK_SECRET=     # the signing secret you type when adding the webhook
# Settings → Webhooks → Add: URL https://<your-bot-host>/lemonsqueezy-webhook,
# events: order_created, order_refunded, subscription_created, subscription_updated,
# subscription_cancelled, subscription_resumed, subscription_expired,
# subscription_paused, subscription_unpaused, subscription_payment_failed
LEMON_VARIANT_PRO=
LEMON_VARIANT_SERVER=
LEMON_VARIANT_LIFETIME=
LEMON_CHECKOUT_PRO=              # https://<store>.lemonsqueezy.com/checkout/buy/<uuid>
LEMON_CHECKOUT_SERVER=
LEMON_CHECKOUT_LIFETIME=
# Yearly variants (optional) and the API key that lets the bot create each
# checkout itself (preferred over buy links: the buyer cannot edit it).
LEMON_VARIANT_PRO_YEARLY=
LEMON_VARIANT_SERVER_YEARLY=
LEMONSQUEEZY_API_KEY=            # Settings → API
LEMONSQUEEZY_STORE_ID=           # Settings → Stores (the number)
# Test-mode purchases are free for anyone to make, so they are ignored unless:
# LEMON_ALLOW_TEST=1

# When BOTH Stripe and Lemon Squeezy links are set, which one /premium shows
# (stripe | lemon). Razorpay's rupee buttons always show beside it.
# PAYMENT_GLOBAL=lemon

# Shown to a buyer whose payment changed nothing (they already had a plan).
# SUPPORT_EMAIL=gameguideai.support@gmail.com

PATREON_URL=
KOFI_URL=

# Top.gg vote rewards — +10 bonus messages for 24h (20 max), NOT a tier grant.
TOPGG_VOTE_URL=                  # https://top.gg/bot/<your_bot_id>/vote
TOPGG_WEBHOOK_AUTH=              # Long random secret; paste same in Top.gg dashboard webhooks

# Affiliate decorators for /price store URLs
HUMBLE_AFFILIATE=
GMG_AFFILIATE=
FANATICAL_AFFILIATE=

# Shared secret proving requests come from this bot, so chat-proxy rate-limits
# per Discord user instead of lumping every user into one IP bucket.
# Must match BOT_SERVICE_TOKEN in the Supabase edge function secrets.
# Generate with: openssl rand -hex 32
BOT_SERVICE_TOKEN=
