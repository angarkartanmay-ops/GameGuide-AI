# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Vite only exposes vars prefixed VITE_.
#
# These point the browser at whichever chat-proxy you want to talk to.

# ── Option A: test against a LOCALLY served edge function ──────────────────
#   supabase functions serve chat-proxy --env-file supabase/functions/.env
# The local functions runtime listens on 54321.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<your project's anon key>

# ── Option B: test against your DEPLOYED project ───────────────────────────
# VITE_SUPABASE_URL=https://vtvjbjmquxqlrwwrmzya.supabase.co
# VITE_SUPABASE_ANON_KEY=<your project's anon key>
#
# Note: Option B talks to whatever is currently deployed. Until you run
# `supabase functions deploy chat-proxy`, that is still the OLD backend.

# ── Analytics, crash reports and search consoles (all optional) ────────────
# Set these in the Vercel project's environment variables, then redeploy.
# Each is off when unset, and its SDK is not even downloaded. Setup steps:
# launch/seo-analytics-setup.md. What is and isn't sent: src/utils/analytics.js.
#
# Vercel Web Analytics — turn it on in the dashboard first. Cookieless.
# VITE_ANALYTICS=vercel
#
# PostHog — Project settings → Project API key (starts with phc_).
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com     # EU project: https://eu.i.posthog.com
#
# Sentry — Project settings → Client Keys (DSN). Browser errors only.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Google Search Console — "HTML tag" verification: only the content="…" value.
# VITE_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bing Webmaster Tools — "HTML Meta Tag" verification: the msvalidate.01 value.
# VITE_BING_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Discord bot's public address. The plans page (#upgrade) calls its
# /api/plans and /api/checkout; unset, the page shows prices only.
# VITE_BILLING_API_URL=https://<your-bot-host>
